generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id          String       @id @default(uuid()) @db.Uuid
  uniqueId    String       @unique
  name        String
  email       String       @unique
  phoneNumber String       @map("phone")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  batch       Batch
  campus      Campus
  department  String
  gender      Gender
  attendances Attendance[]
  resendLogs  ResendLog[]

  @@index([uniqueId])
  @@index([email])
  @@map("members")
}

model Admin {
  id                String           @id @default(uuid()) @db.Uuid
  name              String
  email             String           @unique
  password          String
  role              AdminRole        @default(ADMIN)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  attendancesMarked Attendance[]     @relation("AdminToAttendances")
  eventsCreated     Event[]          @relation("AdminToEvents")
  refreshSessions   RefreshSession[]

  @@index([email])
  @@map("admins")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @db.Uuid
  tokenHash String
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
}

model Event {
  id                    String       @id @default(uuid()) @db.Uuid
  title                 String
  description           String
  eventDate             DateTime     @db.Date
  startTime             DateTime
  endTime               DateTime
  type                  EventType    @default(ONE_TIME)
  isActive              Boolean      @default(true)
  endedAt               DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  createdById           String       @db.Uuid
  manuallyClosedAt      DateTime?
  location              String
  parentEventId         String?      @db.Uuid
  recurrenceIndex       Int?
  recurrenceLengthWeeks Int?
  attendances           Attendance[]
  createdBy             Admin        @relation("AdminToEvents", fields: [createdById], references: [id])
  parentEvent           Event?       @relation("RecurringEvents", fields: [parentEventId], references: [id])
  childrenEvents        Event[]      @relation("RecurringEvents")

  @@index([parentEventId])
  @@index([eventDate])
  @@index([createdById])
  @@map("events")
}

model Attendance {
  id           String     @id @default(uuid()) @db.Uuid
  memberId     String     @db.Uuid
  eventId      String     @db.Uuid
  markedById   String     @db.Uuid
  markedMethod MarkMethod
  markedAt     DateTime   @default(now())
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  markedBy     Admin      @relation("AdminToAttendances", fields: [markedById], references: [id])
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, eventId], name: "memberId_eventId_unique")
  @@index([eventId])
  @@index([memberId])
  @@map("attendances")
}

model ResendLog {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @db.Uuid
  type      String
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([createdAt])
  @@map("resend_logs")
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum EventType {
  ONE_TIME
  WEEKLY
  MONTHLY
}

enum MarkMethod {
  QR
  MANUAL
}

enum Batch {
  FRESHMAN
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  POST_GRADUATE
}

enum Campus {
  FOUR_KILO
  FIVE_KILO
  SIX_KILO
  ART
}

enum Gender {
  MALE
  FEMALE
}
